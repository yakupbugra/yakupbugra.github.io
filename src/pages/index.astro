---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h2 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-3xl">
        RSS
      </h2>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Hi! This is Yakup, full time software engineer since 2013. Mainly focued
        on .NET backend development. In this website you can find my study
        notes, <a href="#bookmarks">bookmarks</a> and latest posts.
        <ul>
          <li>
            - Currently I'm working as Software Architect in a fin-tech company.
          </li>
          <li>
            - Reading books and articles about Software Architecture, DDD,
            Engineering Management, Cloud Computing, and .NET.
          </li>
          <li>- I was Born in Turkiye and I live in Bosnia Hersegovina</li>
          <li>
            - Below you can find my <a class="text-accent" href="#recent-posts"
              >posts</a
            >
            and <a class="text-accent" href="#bookmarks">bookmarks</a>
          </li>
        </ul>
      </p>

      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Find me:</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      sortedPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {sortedPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
          <div class="my-8 text-center">
            <LinkButton href="/posts/">
              All Posts
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }
    <section id="bookmarks" class="pb-12">
      <h2 class="text-2xl font-semibold tracking-wide">Bookmarks</h2>
      <iframe
        style="border: 0; width: 100%; height: 450px;"
        allowfullscreen
        frameborder="0"
        src="https://raindrop.io/yakupbugra/shared-65796598/embed/sort=-created&perpage=10&page=0"
      ></iframe>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
